---
const links = [
  ["WORK", "/#work"],
  ["ABOUT", "/#about"],
  ["WRITING", "/#writing"],
  ["CONTACT", "/#contact"],
];
---

<header class="border-b border-border">
  <div class="site-container flex h-18 items-center justify-between gap-6">
    <a
      class="inline-flex min-h-11 items-center text-xl font-semibold tracking-tight"
      href="/#intro"
      aria-label="Arnold Curiano, home"
    >
      AC.
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-7 font-mono text-xs tracking-wide lg:gap-10">
        {links.map(([label, href]) => (
          <li>
            <a
              class="nav-link inline-flex min-h-11 items-center"
              href={href}
              aria-label={label}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      aria-controls="mobile-navigation"
      aria-expanded="false"
      class="flex size-11 items-center justify-center md:hidden"
      aria-label="Menu"
    >
      <span class="flex flex-col gap-1.5" aria-hidden="true">
        <span class="h-px w-5 bg-foreground"></span>
        <span class="h-px w-5 bg-foreground"></span>
      </span>
    </button>
  </div>
  <div id="mobile-navigation" class="mobile-panel" inert>
    <nav aria-label="Mobile" class="min-h-0 overflow-hidden">
      <ul class="site-container border-t border-border py-4 font-mono text-sm tracking-wide">
        {links.map(([label, href]) => (
          <li>
            <a
              class="nav-link flex min-h-12 items-center"
              href={href}
              aria-label={label}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-link::after {
    content: " |";
    opacity: 0;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    opacity: 1;
    animation: cursor-blink 1s steps(1, end) infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link:hover::after,
    .nav-link:focus-visible::after {
      animation: none;
    }
  }

  .mobile-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--motion-duration);
  }

  .mobile-panel:not([inert]) {
    grid-template-rows: 1fr;
  }

  @media (min-width: 48rem) {
    .mobile-panel {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle")!;
  const panel = document.querySelector<HTMLElement>("#mobile-navigation")!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Menu");
    panel.inert = !open;
  };

  toggle.addEventListener("click", () => setOpen(panel.inert));
  toggle.closest("header")!.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !panel.inert) {
      setOpen(false);
      toggle.focus();
    }
  });
  panel.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a"))
      setOpen(false);
  });
</script>
